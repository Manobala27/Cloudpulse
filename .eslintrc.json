{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "globals": {
    "ApiClient": "readonly",
    "ChartManager": "readonly",
    "Utils": "readonly",
    "Chart": "readonly",
    "API_BASE_URL": "writable"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "warn"
  }
}
